{
  "name": "weather-alerts-card",
  "version": "3.5.0",
  "description": "A custom Home Assistant Lovelace card for displaying weather alerts",
  "main": "dist/weather-alerts-card.js",
  "module": "dist/weather-alerts-card.js",
  "scripts": {
    "build": "rolldown -c",
    "watch": "rolldown -c --watch",
    "lint": "tsc --noEmit -p tsconfig.eslint.json && eslint src tests vitest.config.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.js",
    "screenshot:update": "npm run build && npm run screenshot",
    "screenshot:hero": "npm run build && npm run screenshot && bash scripts/encode-adaptive-svgs.sh",
    "screenshot:editor": "node scripts/capture-editor.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:media": "bash scripts/build-docs-media.sh"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "nws",
    "bom",
    "meteoalarm",
    "weather",
    "alerts"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@types/dompurify": "^3.2.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-recommended-bump": "^12.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-lit": "^2.3.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.12.0",
    "home-assistant-js-websocket": "^9.7.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "rolldown": "^1.2.11",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "lit": "^3.3.3"
  }
}
